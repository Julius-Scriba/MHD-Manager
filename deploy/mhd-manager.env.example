# Auf dem Server als /etc/mhd-manager.env ablegen (chmod 600, owner root)
# NICHT ins Repo committen.

# Ersteinrichtung: Benutzer wird nur angelegt, wenn noch keiner existiert.
MHD_ADMIN_USER=julius
MHD_ADMIN_PASS=hier-ein-langes-passwort-eintragen

# Optional: festes Session-Geheimnis statt automatisch erzeugtem
# MHD_SESSION_SECRET=

# Nur für lokale Tests ohne HTTPS setzen — nie im Produktivbetrieb.
# MHD_INSECURE_COOKIES=1
